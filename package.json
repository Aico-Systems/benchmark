        "test": "bun test"
    },
    "dependencies": {
        "chalk": "^6.0.0",
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
}